Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always serve over HTTPS (Hostinger issues the certificate for free).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pretty URL: codeart.fun/learn → app.html (no trailing slash, so relative assets resolve)
    RewriteRule ^learn/$ /learn [R=301,L]
    RewriteRule ^learn$ app.html [L]

    # Developer-only folders and files are not part of the site.
    RewriteRule ^(tools|screenshots)(/|$) - [F,L]
    RewriteRule (^|/)(README\.md|DEPLOY\.md)$ - [F,L]
</IfModule>

<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType text/plain .py
    AddType application/json .json
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType text/plain "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>
